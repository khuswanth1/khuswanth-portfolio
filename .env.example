# Copy to .env and fill in. Never commit .env.

# Server Configuration
PORT=5000
# development | production  (production turns off DEBUG and requires ALLOWED_HOSTS)
NODE_ENV=development

# Production only
# DJANGO_SECRET_KEY=generate-a-long-random-string
# ALLOWED_HOSTS=your-api.onrender.com
# TRUSTED_PROXY_COUNT=1          # reverse proxies in front of the app (Render/Railway = 1)
# REDIS_URL=redis://...          # share the rate limit across several workers/instances

# Email Configuration (SMTP — Gmail by default; any provider works by changing these)
# Gmail app password: https://myaccount.google.com/apppasswords (requires 2-Step Verification)
# Gmail: port 587 + EMAIL_SECURE=false (STARTTLS), or port 465 + EMAIL_SECURE=true
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your.email@gmail.com
EMAIL_PASS=your-16-char-app-password

# Email Destination & Sender Default
EMAIL_TO=your.email@gmail.com
EMAIL_FROM=your.email@gmail.com

# CORS - Allowed origins (comma-separated)
ALLOWED_ORIGIN=http://localhost:3000,http://localhost:5173,https://khuswanthportfolio.vercel.app

# Rate limit per IP (defaults: 5 per 15 min in production, 100 in development)
# CONTACT_RATE_LIMIT=5
# CONTACT_RATE_WINDOW_SECONDS=900

# Fallback: Resend, used if SMTP fails (e.g. Gmail daily limit). https://resend.com
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM="Portfolio Contact <contact@yourdomain.com>"

# Optional Webhook Integration (Discord / Slack / Custom URL, https only)
# WEBHOOK_URL=https://discord.com/api/webhooks/your-id/your-token
