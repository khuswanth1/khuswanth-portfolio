# Server Configuration
PORT=5000
NODE_ENV=development

# Email Configuration (SMTP — Gmail by default; any provider works by changing these)
# Gmail app password: https://myaccount.google.com/apppasswords (requires 2-Step Verification)
# NOTE: Free Gmail has a daily SMTP sending limit (~500/day, lower for newer accounts).
# When that limit is hit the API automatically falls back to Resend, then an Ethereal sandbox.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=khuswanthraojadav@gmail.com
EMAIL_PASS=qlcc tgpe ceij asaq

# Email Destination & Sender Default
EMAIL_TO=khuswanthraojadav@gmail.com
EMAIL_FROM=khuswanthraojadav@gmail.com

# CORS - Allowed origins (comma-separated)
ALLOWED_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5173,https://khuswanthportfolio.vercel.app

# ── Fallback: Resend (quota-free delivery, recommended for reliability) ──
# 1) Create a free account at https://resend.com  (3,000 emails/month free)
# 2) Verify your sending domain, then generate an API key
# 3) Uncomment and fill these two lines:
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM="Portfolio Contact <contact@yourdomain.com>"

# Optional Webhook Integration (Discord / Slack / Custom URL)
# WEBHOOK_URL=https://discord.com/api/webhooks/your-id/your-token